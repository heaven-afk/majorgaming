# MGL site environment. Copy to .env.local and fill in. Names only here; never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server or this machine.

# --- Production (Vercel) and local -------------------------------------------------------
# The site's public address, and the database it reads (read-only through row level security).
NEXT_PUBLIC_SITE_URL=https://mglwebsite.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Fantasy Core: server only, separate staging/production credentials -----------------
# HTTPS origin only, without /api/v1. Obtain the real staging address from the partner.
FANTASY_CORE_URL=
FANTASY_SITE_SLUG=
FANTASY_PARTNER_API_KEY=
FANTASY_PROFILE_API_KEY=

# Heaven Index player portraits, profile labels and team branding (server only).
HSE_BASE_URL=
HSE_API_SECRET=
# Dedicated Heaven Index live results credential. Must match the Index deployment.
MGL_RESULTS_API_KEY=
# Separate signing secret shared with Heaven Index Supabase Vault.
MGL_RESULTS_WEBHOOK_SECRET=
# Optional automatic refresh without visitors, via an authenticated scheduler.
CRON_SECRET=
# Public issuer must exactly match the Fantasy Core website registry.
FANTASY_JWT_ISSUER=
# RSA private PKCS8 PEM, at least 2048 bits. Multiline or literal \n supported.
FANTASY_JWT_PRIVATE_KEY=

# --- Local only: terminal work --------------------------------------------------------------
# Full access, bypasses row level security: the import script (scripts/import-league.mjs).
SUPABASE_SECRET_KEY=
# Migrations from the terminal: supabase db push --db-url "$DATABASE_URL" (session pooler,
# works on IPv4; the direct db.<ref> host is IPv6 only).
SUPABASE_PROJECT_REF=
DATABASE_URL=

# --- Admin image uploads (not used yet; add to Vercel when the admin ships) -----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
