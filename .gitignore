# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real keys live only in .env.local; .env.example lists the names
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tools and editors
.claude/settings.local.json
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# python (scripts/)
__pycache__/
*.pyc

# raw data sheets from the owner: imported through scripts/, never committed
*.xlsx
*.xls

# supabase cli
supabase/.temp/
supabase/.branches/
